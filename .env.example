# Copy to `.env.development` (local `npm run dev`) and/or `.env.production` (local `npm run build`).
# Both files are gitignored. On Vercel, set the same keys in Project → Settings → Environment Variables.

# Auth / NextAuth
AUTH_SECRET=generate_a_long_random_string
NEXTAUTH_SECRET=generate_a_long_random_string
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Analytics (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Database
DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# GitHub App (dashboard install + sandbox PR creation)
GITHUB_APP_SLUG=
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_APP_SETTINGS_URL=https://github.com/settings/apps/YOUR_APP_SLUG
GITHUB_APP_WEBHOOK_SECRET=

# E2B + MiniMax (feedback agent)
E2B_API_KEY=
E2B_FEEDBACK_SANDBOX_TEMPLATE=feedback2code-agent
MINIMAX_API_KEY=
E2B_WEBHOOK_SECRET=

# Email (Resend)
RESEND_API_KEY=
RESEND_EMAIL_MODE=production
RESEND_TEST_TO=delivered@resend.dev
RESEND_FROM_EMAIL=notifications@example.com
RESEND_FROM_NAME=Feedback2Code

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PRO_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Discord webhooks (server-only)
DISCORD_LEGAL_CONTACT_WEBHOOK_URL=
DISCORD_NEW_USER_WEBHOOK_URL=

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
