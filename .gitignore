# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Only `.env.development` and `.env.production` are used. Ignore ad-hoc copies so they are never committed.
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
stripe_backup_code.txt

# Built from .env.* on prebuild/predev (required on Vercel — serverless bundle has no .env files).
/lib/generated/server-env.ts

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
