{
  "name": "feedback2code",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "predev": "prisma generate && node scripts/generate-server-env.mjs --development",
    "prebuild": "node scripts/generate-server-env.mjs --production",
    "dev": "next dev",
    "build": "dotenv -e .env.production -- prisma migrate deploy && next build",
    "start": "next start",
    "lint": "eslint",
    "billing:setup-stripe": "dotenv -e .env.development -- node scripts/setup-stripe-plans.mjs",
    "migrate:dev": "dotenv -e .env.development -- prisma migrate dev",
    "tunnel:tailscale": "node scripts/tailscale-dev-tunnel.mjs",
    "tunnel:tailscale:funnel": "node scripts/tailscale-dev-tunnel.mjs --funnel",
    "test:e2b-feedback-sandbox": "dotenv -e .env.development -- npx tsx scripts/test-e2b-feedback-sandbox.ts",
    "test:e2b-production-like": "dotenv -e .env.development -- npx tsx scripts/test-e2b-production-like.ts"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@next/mdx": "^16.2.0",
    "@next/third-parties": "^16.2.0",
    "@prisma/client": "^6.19.2",
    "@radix-ui/react-toast": "^1.2.15",
    "@types/mdx": "^2.0.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "e2b": "^2.14.1",
    "jose": "^6.2.2",
    "lucide-react": "^0.577.0",
    "next": "16.2.0",
    "next-auth": "^4.24.13",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.9.4",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "stripe": "^20.4.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^16.6.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.0",
    "next-sitemap": "^4.2.3",
    "prisma": "^6.19.2",
    "tailwindcss": "^4",
    "tsx": "^4.20.5",
    "typescript": "^5"
  }
}
