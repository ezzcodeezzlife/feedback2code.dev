generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  githubAppInstalled Boolean @default(false)
  githubInstallationId String?
  accounts      Account[]
  sessions      Session[]
  repositoryConfigs RepositoryConfig[]
  feedbackLimitEvents UserFeedbackLimitEvent[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum WidgetFeedbackStatus {
  CODING
  WAITING_FOR_REVIEW
  MERGED
  FAILED
}

model RepositoryConfig {
  id                String   @id @default(cuid())
  userId            String
  owner             String
  repo              String
  fullName          String
  widgetId          String   @unique @default(cuid())
  authorizedDomains Json
  receivePrCreatedEmail Boolean @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  widgetFeedbacks   WidgetFeedback[]

  @@unique([userId, fullName])
}

model WidgetFeedback {
  id                 String               @id @default(cuid())
  repositoryConfigId String
  body               String
  pageUrl            String?
  status             WidgetFeedbackStatus @default(CODING)
  createdAt          DateTime             @default(now())
  e2bSandboxId       String?
  prUrl              String?
  agentError         String?              @db.Text
  agentFinishedAt    DateTime?

  repositoryConfig RepositoryConfig @relation(fields: [repositoryConfigId], references: [id], onDelete: Cascade)
  feedbackLimitEvents UserFeedbackLimitEvent[]

  @@index([repositoryConfigId, createdAt])
}

/**
 * Tracks feedback submissions per user so we can enforce a rolling "100 feedbacks per 30 days"
 * quota efficiently via an indexed (userId, createdAt) range query.
 */
model UserFeedbackLimitEvent {
  id                String   @id @default(cuid())
  userId            String
  widgetFeedbackId String   @unique
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  widgetFeedback WidgetFeedback @relation(fields: [widgetFeedbackId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
